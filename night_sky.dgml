<?xml version="1.0" encoding="UTF-8"?>
<!--
    night_sky.dgml - Marble / digiKam map theme for the night sky.

    This theme is installed by hand. script.py only generates the content
    (final/*.geojson.kml); it never writes or copies this file.

    INSTALL LAYOUT
    ==============
    Create a folder named "night_sky" inside the "earth" map target of the
    program that should display it:

        digiKam (native):  ~/.local/share/digikam/marble_data/maps/earth/night_sky/
        digiKam (flatpak): ~/.var/app/org.kde.digikam/data/digikam/marble_data/maps/earth/night_sky/
        digiKam (Windows): %LOCALAPPDATA%\digikam\marble_data\maps\earth\night_sky\
        Marble:            ~/.local/share/marble/maps/earth/night_sky/

    Put in it:

        night_sky.dgml                              (this file)
        mirrored.jpg                                (install map, see below)
        constellations_borders_mirror.geojson.kml   (copied from final/)
        constellations_lines_mirror.geojson.kml
        constellations_mirror.geojson.kml
        dsos_mag6_mirror.geojson.kml
        stars_6_mirror.geojson.kml

    THE TILES
    =========
    The panorama is read from a tile pyramid placed directly inside the
    theme folder (no "tiles/" subfolder):

        night_sky/<z>/<yyyyyy>/<yyyyyy>_<xxxxxx>.jpg

    Generate it with tile_maker.py and copy the numbered folders over:

        MAX_ZOOM=4 TILE_SOURCE=final/mirrored.jpg python3 tile_maker.py
        cp -r tiles/* <theme>/

    For an 8192x4096 source, zoom 0-4 is enough: z3 is 1:1 and z4 is a 2x
    upscale. Generate higher levels only from a larger source (the 32k
    starmap is 1:1 around z5).

    THE INSTALL MAP
    ===============
    If the tiles are missing, Marble can build them itself from the
    <installmap> the first time the theme is opened. Those tiles go to
    Marble's cache instead:

        ~/.cache/marble/maps/earth/night_sky/

    Marble's tile generator (TileCreator) refuses images larger than
    21600x10800 pixels, so mirrored.jpg (8192x4096) is safely inside that
    limit. A 32k starmap would have to be downscaled before use as an
    install map.
-->
<dgml xmlns="http://edu.kde.org/marble/dgml/2.0">
    <document>
        <head>
            <license short="Public Domain">Source: NASA SVS Milky Way panorama, ESA Gaia / HYG star and constellation data. Licenses: Public Domain / CC BY-SA.</license>
            <name>Night Sky</name>
            <target>earth</target>
            <theme>night_sky</theme>

            <visible>true</visible>

            <description><![CDATA[<p>The <i>night sky</i> as a panorama.</p><p>NASA Milky Way image with stars, deep sky objects and constellation lines.</p>]]></description>

            <zoom>
                <minimum>  900  </minimum>
                <maximum> 2100  </maximum>

                <!-- describes whether you can zoom through the levels
                    continuously -->
                <discrete> false </discrete>
            </zoom>
        </head>

        <!-- Now we create the layer structure that gets handled by the
            layer management class -->

        <map bgcolor="#000000" labelColor="#ffffff">
            <canvas/>
            <target/>

            <!-- The background panorama -->
            <layer name="night_sky" backend="texture">
                <texture name="night_sky_data">
                    <sourcedir format="JPG"> earth/night_sky </sourcedir>
                    <installmap> mirrored.jpg </installmap>
                    <storageLayout maximumTileLevel="7"/>
                </texture>
            </layer>

            <!-- Stars, deep sky objects and constellation figures -->
            <layer name="celestial places" backend="geodata">
                <geodata name="constellation_borders">
                    <sourcefile format="KML"> maps/earth/night_sky/constellations_borders_mirror.geojson.kml </sourcefile>
                </geodata>
                <geodata name="constellation_lines">
                    <sourcefile format="KML"> maps/earth/night_sky/constellations_lines_mirror.geojson.kml </sourcefile>
                </geodata>
                <geodata name="constellations">
                    <sourcefile format="KML"> maps/earth/night_sky/constellations_mirror.geojson.kml </sourcefile>
                </geodata>
                <geodata name="deep_sky_objects">
                    <sourcefile format="KML"> maps/earth/night_sky/dsos_mag6_mirror.geojson.kml </sourcefile>
                </geodata>
                <geodata name="stars">
                    <sourcefile format="KML"> maps/earth/night_sky/stars_6_mirror.geojson.kml </sourcefile>
                </geodata>
            </layer>
        </map>

        <settings>
            <property name="coordinate-grid">
                <value>true</value>
                <available>true</available>
            </property>
            <property name="overviewmap">
                <value>true</value>
                <available>true</available>
            </property>
            <property name="compass">
                <value>true</value>
                <available>true</available>
            </property>
            <property name="scalebar">
                <value>true</value>
                <available>true</available>
            </property>
        </settings>
    </document>
</dgml>
